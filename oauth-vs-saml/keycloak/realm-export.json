{
  "realm": "delegacion-demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",

  "clients": [
    {
      "clientId": "oauth-oidc-poc-client",
      "name": "OAuth2 + OIDC POC",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "oidc-poc-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"]
    },
    {
      "clientId": "http://localhost:4000/saml/metadata",
      "name": "SAML POC",
      "enabled": true,
      "protocol": "saml",
      "publicClient": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:4000/*"],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.authnstatement": "true",
        "saml_name_id_format": "email",
        "saml_force_name_id_format": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_single_logout_service_url_post": "http://localhost:4000/saml/logout/callback",
        "saml_assertion_consumer_url_post": "http://localhost:4000/saml/acs"
      },
      "protocolMappers": [
        {
          "name": "email-mapper",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic",
            "friendly.name": "email"
          }
        },
        {
          "name": "role-list-mapper",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "config": {
            "single": "false",
            "attribute.nameformat": "Basic",
            "attribute.name": "Role"
          }
        }
      ]
    }
  ],

  "roles": {
    "realm": [{ "name": "usuario-demo" }]
  },

  "users": [
    {
      "username": "luis.demo",
      "email": "luis.demo@example.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Luis",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "Demo1234!",
          "temporary": false
        }
      ],
      "realmRoles": ["usuario-demo"]
    }
  ]
}
